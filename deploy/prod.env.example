# Copy to deploy/prod.env (gitignored) and fill in.
# Generate secrets with the commands in deploy/RUNBOOK.md. Never commit real values.

# Services to start besides the core stack: "backup" (nightly backups; keep it in
# production), add "tunnel" for Cloudflare Tunnel mode. Comma separated.
COMPOSE_PROFILES=backup

# --- Site ------------------------------------------------------------------------
HOMEOA_DOMAIN=localhost
HOMEOA_ALLOWED_HOSTS=localhost
HOMEOA_CSRF_TRUSTED_ORIGINS=https://localhost
# Public https origin used in emailed links (required; checked at start-up).
HOMEOA_BASE_URL=https://localhost
HOMEOA_ACME_EMAIL=admin@example.org

# --- Secrets (required; the app refuses to start without them) -----------------------
HOMEOA_SECRET_KEY=change-me
# Fernet keys, newest first, comma-separated (field encryption).
HOMEOA_FIELD_KEYS=change-me
HOMEOA_DB_PASSWORD=change-me

# --- Database ------------------------------------------------------------------------
HOMEOA_DB_USER=homeoa
HOMEOA_DB_NAME=homeoa

# --- Email: any SMTP provider -------------------------------------------------
HOMEOA_EMAIL_HOST=smtp.example.org
HOMEOA_EMAIL_PORT=587
HOMEOA_EMAIL_USE_TLS=1
# Port 465 (implicit SSL, e.g. Resend SMTPS): set HOMEOA_EMAIL_PORT=465 and USE_SSL=1;
# TLS is then turned off automatically.
HOMEOA_EMAIL_USE_SSL=0
HOMEOA_EMAIL_USER=
HOMEOA_EMAIL_PASSWORD=
# Notices go out as "<association name> <this address>".
HOMEOA_DEFAULT_FROM_EMAIL=notices@example.org
# Replies to notices go here (a board member's own email).
HOMEOA_EMAIL_REPLY_TO=
HOMEOA_SERVER_EMAIL=homeoa-errors@example.org

# --- Error alerts --------------------------------------------------------------------
# Comma-separated emails that receive 500-error reports.
HOMEOA_ADMINS=
# Optional Sentry-compatible DSN (Sentry, GlitchTip, ...).
HOMEOA_SENTRY_DSN=
HOMEOA_LOG_LEVEL=INFO

# --- App -----------------------------------------------------------------------------
# Plugins to load, comma separated, e.g. simplefin,stripe,rulepack_us_wa,tesseract,anthropic
# (tesseract reads scanned documents for search; the image includes the program;
# anthropic is AI assistance: its API key is entered under Settings > Plugins).
HOMEOA_PLUGINS=
HOMEOA_ADMIN_ENABLED=0

# --- Backups: any S3-compatible bucket ----------------------------------------
# age PUBLIC key(s); the matching secret key is kept offline by the board (RUNBOOK).
# At least two holders (treasurer + president), space separated. See RUNBOOK section 8.
BACKUP_AGE_RECIPIENTS="age1change-me-treasurer age1change-me-president"
BACKUP_S3_BUCKET=
BACKUP_S3_PREFIX=homeoa/
# Leave empty for AWS S3; set for MinIO, Backblaze B2, Cloudflare R2, Wasabi, ...
BACKUP_S3_ENDPOINT=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
BACKUP_RETENTION_DAYS=35
BACKUP_HOUR_UTC=09
BACKUP_OK_WEBHOOK=
BACKUP_FAIL_WEBHOOK=

# --- Cloudflare Tunnel (optional): compose --profile tunnel --------------------
# TLS ends at Cloudflare; Caddy serves plain HTTP to cloudflared. Public hostname in the
# Cloudflare dashboard -> service http://caddy:80. Token: Zero Trust > Tunnels > token.
# The tunnel token does NOT go here (prod.env reaches web, worker and backup). Put it in
# deploy/tunnel.env as TUNNEL_TOKEN=... (chmod 600, gitignored); only cloudflared reads it.
HOMEOA_TLS_MODE=caddy
# In tunnel mode keep Caddy off public interfaces:
# HOMEOA_HTTP_PORT=127.0.0.1:8080
# HOMEOA_HTTPS_PORT=127.0.0.1:8443

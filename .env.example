# Copy to .env (gitignored). Real environment variables override these.

# Database (shared docker compose Postgres). Give each worktree its own name, e.g.
# homeoa_m1_02; pytest then uses test_<name>, so parallel worktrees never collide.
HOMEOA_DB_HOST=localhost
HOMEOA_DB_PORT=5432
HOMEOA_DB_NAME=homeoa
HOMEOA_DB_USER=homeoa
HOMEOA_DB_PASSWORD=homeoa

# Email: dev prints messages (magic links included) in the runserver terminal.
HOMEOA_DEFAULT_FROM_EMAIL=homeoa@localhost

# Field-encryption keys (Fernet), newest first, comma-separated. Dev/test have defaults.
# HOMEOA_FIELD_KEYS=

# Production only.
# HOMEOA_SECRET_KEY=
# HOMEOA_ALLOWED_HOSTS=example.org
# HOMEOA_CSRF_TRUSTED_ORIGINS=https://example.org
# Public https origin for emailed links (required in prod; dev falls back to the request).
# HOMEOA_BASE_URL=https://example.org
# Reverse-proxy IPs/CIDRs whose X-Forwarded-For is trusted for the client IP.
# HOMEOA_TRUSTED_PROXIES=

# Plugins, comma-separated. Dev defaults to simplefin when unset (demo bank feed).
HOMEOA_PLUGINS=simplefin,rulepack_us_wa
